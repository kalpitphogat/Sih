# Copy to .env and fill what you have. Every key here is OPTIONAL:
# each fetcher falls back to a keyless source and logs which one it used.

# OpenTopography Global DEM API (free academic key).
# Only used if the keyless Copernicus S3 and Planetary Computer paths both fail.
# Rate limit ~200 calls/day; 450,000 km2 cap per 30 m request.
OPENTOPO_API_KEY=

# Google Earth Engine service account JSON (Phase 8 real-time monitoring).
# If unset, the Real-time Monitoring page shows a "GEE not configured" state
# and a clearly-labelled cached demo result. It never fakes a live feed.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: override external engine binary locations.
DFLOWFM_BIN=
DIMR_BIN=
DUALSPHYSICS_BIN=
GENCASE_BIN=

# Backend
FLOODGUARD_DATA_DIR=./data
FLOODGUARD_LOG_LEVEL=INFO
